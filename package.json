{
  "name": "snoopys-home",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:worker": "wrangler dev",
    "build": "tsc -b && vite build",
    "check:worker": "tsc -p worker/tsconfig.json",
    "cloud:migrate": "wrangler d1 migrations apply DB --remote",
    "cloud:deploy": "npm run check:worker && wrangler deploy",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource/inconsolata": "^5.3.0",
    "@fontsource/vt323": "^5.3.0",
    "heic-to": "^1.6.6",
    "leaflet": "^1.9.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "suncalc": "^2.1.1",
    "vite-plugin-pwa": "^2.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261015.1",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "wrangler": "^4.151.0"
  }
}
