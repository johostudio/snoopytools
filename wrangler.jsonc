{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "snoopy-home-sync",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-15",
  "observability": {
    "enabled": true
  },
  "vars": {
    "APP_ORIGINS": "https://snoopytools.vercel.app,https://snoopytools-johostudios-projects.vercel.app,https://snoopytools-git-main-johostudios-projects.vercel.app,http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "snoopy-home-db",
      "database_id": "0b890a1b-b226-4d74-ba3b-e77da4b71813",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "snoopy-home-media"
    }
  ]
}
